# Copy to .env and adjust. All values below are the defaults; nothing here is required
# to run the demo or the evaluation (the deterministic mock LLM is used by default).

# LLM mode: "mock" (default, deterministic, offline, reproducible) or "live".
KIVI_LLM_MODE=mock

# Required ONLY when KIVI_LLM_MODE=live. Never commit a real key.
ANTHROPIC_API_KEY=

# Model used when KIVI_LLM_MODE=live.
KIVI_LLM_MODEL=claude-sonnet-5

# Path to the SQLite database file. Delete this file (or POST /reset) to reset.
KIVI_DB_PATH=kivi.db

# Score in [0,1] at/above which an active memory entry is applied to a span.
KIVI_APPLY_THRESHOLD=0.72

# Number of corroborating observations needed to promote a candidate to active
# (an explicit dictionary add promotes immediately regardless of this value).
KIVI_PROMOTE_AFTER=2

# Number of rejections after which an entry is suppressed.
KIVI_SUPPRESS_AFTER=2
