{"id": "exact-01", "category": "exact_match", "description": "lowercased canonical, software context", "input": "deploy kivi now", "target_span": "kivi", "expected_action": "REPLACE", "expected_output": "Deploy Kivi now."}
{"id": "normalized-01", "category": "normalized_match", "description": "uppercased alias with punctuation", "input": "open KIWI, service", "target_span": "kiwi", "expected_action": "REPLACE", "expected_output": "Open Kivi, service."}
{"id": "fuzzy-01", "category": "fuzzy_match", "description": "near-miss spelling, strong context", "input": "open the kivee dashboard", "target_span": "kivee", "expected_action": "REPLACE", "expected_output": "Open the Kivi dashboard."}
{"id": "phonetic-01", "category": "phonetic_match", "description": "phonetic cousin, software context", "input": "restart the kibi process", "target_span": "kibi", "expected_action": "REPLACE", "expected_output": "Restart the Kivi process."}
{"id": "strong-01", "category": "strong_memory", "description": "flagship: software context -> REPLACE", "input": "open the kiwi service", "target_span": "kiwi", "expected_action": "REPLACE", "expected_output": "Open the Kivi service."}
{"id": "noninterv-01", "category": "contextual_contradiction", "description": "flagship: fruit context -> deliberate KEEP", "input": "I ate a kiwi today", "target_span": "kiwi", "expected_action": "KEEP", "expected_output": "I ate a kiwi today.", "check_stability": "Kivi"}
{"id": "noninterv-02", "category": "contextual_contradiction", "description": "another food context", "input": "the kiwi juice was tasty", "target_span": "kiwi", "expected_action": "KEEP", "expected_output": "The kiwi juice was tasty.", "check_stability": "Kivi"}
{"id": "weak-01", "category": "weak_memory", "description": "proposed memory -> DEFER, never auto-REPLACE", "input": "we should ship devy this sprint", "target_span": "devy", "expected_action": "DEFER", "expected_output": "We should ship devy this sprint."}
{"id": "ambiguous-01", "category": "ambiguous_candidate", "description": "civi matches Kivi and Sivi, thin context -> DEFER", "input": "ask civi", "target_span": "civi", "expected_action": "DEFER", "expected_output": "Ask civi."}
{"id": "newword-01", "category": "new_word", "description": "unknown term -> KEEP, no hallucinated memory", "input": "deploy the zephyr module", "target_span": "zephyr", "expected_action": "KEEP", "expected_output": "Deploy the zephyr module."}
{"id": "acronym-01", "category": "entity_type_acronym", "description": "acronym mishearing -> REPLACE", "input": "start the mcb server", "target_span": "mcb", "expected_action": "REPLACE", "expected_output": "Start the MCP server."}
{"id": "acronym-02", "category": "acronym_false_friend", "description": "MVP is not MCP -> KEEP", "input": "that was our mvp", "target_span": "mvp", "expected_action": "KEEP", "expected_output": "That was our mvp."}
{"id": "company-01", "category": "entity_type_company", "description": "company mishearing -> REPLACE", "input": "I work at sarwam now", "target_span": "sarwam", "expected_action": "REPLACE", "expected_output": "I work at Sarvam now."}
{"id": "person-01", "category": "entity_type_person", "description": "colleague name mishearing -> REPLACE", "input": "I told sibi about the meeting", "target_span": "sibi", "expected_action": "REPLACE", "expected_output": "I told Sivi about the meeting."}
{"id": "correction-01", "category": "explicit_correction", "description": "correction creates memory; next utterance -> REPLACE", "setup": [{"type": "explicit_correction", "chosen_form": "Nimbus", "rejected_form": "nimbers", "context": {"keywords": ["restart", "server"], "domain": "software"}}], "input": "restart the nimbers server", "target_span": "nimbers", "expected_action": "REPLACE", "expected_output": "Restart the Nimbus server."}
{"id": "repeated-01", "category": "repeated_observation", "description": "3 weak observations accumulate but stay proposed -> DEFER", "setup": [{"type": "asr_pair", "chosen_form": "Lumen", "context": {"keywords": ["open", "panel"], "domain": "software"}}, {"type": "asr_pair", "chosen_form": "Lumen", "context": {"keywords": ["open", "panel"], "domain": "software"}}, {"type": "asr_pair", "chosen_form": "Lumen", "context": {"keywords": ["open", "panel"], "domain": "software"}}], "input": "open the lumen panel", "target_span": "lumen", "expected_action": "DEFER", "expected_output": "Open the lumen panel."}
{"id": "rejection-01a", "category": "user_rejection", "description": "after a scoped rejection, that context KEEPs", "setup": [{"type": "rejection", "rejected_form": "Kivi", "chosen_form": "kiwi", "context": {"keywords": ["planted", "vine", "garden"], "domain": "general"}}], "input": "I planted a kiwi vine in the garden", "target_span": "kiwi", "expected_action": "KEEP", "expected_output": "I planted a kiwi vine in the garden.", "check_stability": "Kivi"}
{"id": "rejection-01b", "category": "user_rejection", "description": "same rejection must NOT break the software context", "setup": [{"type": "rejection", "rejected_form": "Kivi", "chosen_form": "kiwi", "context": {"keywords": ["planted", "vine", "garden"], "domain": "general"}}], "input": "deploy kiwi to staging", "target_span": "kiwi", "expected_action": "REPLACE", "expected_output": "Deploy Kivi to staging.", "check_stability": "Kivi"}
{"id": "conflict-01", "category": "conflicting_memories", "description": "two memories claim the same alias -> DEFER", "setup": [{"type": "explicit_correction", "chosen_form": "Kayo", "rejected_form": "kaya", "context": {"keywords": ["call"], "domain": "people"}}, {"type": "explicit_correction", "chosen_form": "Kaira", "rejected_form": "kaya", "context": {"keywords": ["call"], "domain": "people"}}], "input": "call kaya please", "target_span": "kaya", "expected_action": "DEFER", "expected_output": "Call kaya please."}
{"id": "idempotency-01", "category": "idempotency", "description": "processing twice is identical and does not grow memory", "input": "open the kiwi service", "target_span": "kiwi", "expected_action": "REPLACE", "expected_output": "Open the Kivi service.", "repeat": 2}
{"id": "multi-01", "category": "multi_entity", "description": "entity #1 has software context (REPLACE); entity #2 has no supporting context, so it is only surfaced as a suggestion (DEFER), not auto-applied", "input": "open kiwi and tell sibi", "target_span": "sibi", "expected_action": "DEFER", "expected_output": "Open Kivi and tell sibi."}
{"id": "noninterv-03", "category": "contextual_contradiction", "description": "plural fruit form in shopping context -> KEEP", "input": "I need to buy kiwis and apples at the store", "target_span": "kiwis", "expected_action": "KEEP", "expected_output": "I need to buy kiwis and apples at the store.", "check_stability": "Kivi"}
{"id": "confirm-01", "category": "user_confirmation", "description": "confirming a suggestion promotes proposed -> active -> REPLACE", "setup": [{"type": "asr_pair", "chosen_form": "Halo", "context": {"keywords": ["deploy", "cluster"], "domain": "software"}}, {"type": "confirmation", "chosen_form": "Halo", "rejected_form": "hallo", "context": {"keywords": ["deploy", "cluster"], "domain": "software"}}], "input": "deploy hallo to the cluster", "target_span": "hallo", "expected_action": "REPLACE", "expected_output": "Deploy Halo to the cluster."}
{"id": "personal-learn-01", "category": "personal_phonetics", "description": "accent rule learned from corrections (l->r onset) nominates a NEVER-SEEN misheard surface that generic phonetics + fuzzy both miss", "setup": [{"type": "explicit_correction", "chosen_form": "Rehan", "rejected_form": "lehaan", "context": {"keywords": ["tell", "review", "sync", "meeting"], "domain": "people"}}, {"type": "explicit_correction", "chosen_form": "Rehan", "rejected_form": "lehin", "context": {"keywords": ["tell", "review", "sync", "meeting"], "domain": "people"}}], "input": "tell lehan about the sync", "target_span": "lehan", "expected_action": "REPLACE", "expected_output": "Tell Rehan about the sync.", "expect_reason_contains": "accent profile"}
{"id": "personal-prior-01", "category": "personal_phonetics", "description": "disambiguation prior: 3 prior Sivi mishearings lift a borderline match over the line. Same input as multi-01, which DEFERs with no history.", "setup": [{"type": "explicit_correction", "chosen_form": "Sivi", "rejected_form": "sivvy", "context": {"keywords": ["told", "meeting", "review", "call"], "domain": "people"}}, {"type": "explicit_correction", "chosen_form": "Sivi", "rejected_form": "siviee", "context": {"keywords": ["told", "meeting", "review", "call"], "domain": "people"}}, {"type": "explicit_correction", "chosen_form": "Sivi", "rejected_form": "seavey", "context": {"keywords": ["told", "meeting", "review", "call"], "domain": "people"}}], "input": "open kiwi and tell sibi", "target_span": "sibi", "expected_action": "REPLACE", "expected_output": "Open Kivi and tell Sivi.", "expect_reason_contains": "mis-spelled 'Sivi'"}
{"id": "personal-tiebreak-01", "category": "personal_phonetics", "description": "correction history breaks a genuine ambiguity. Same input as ambiguous-01 ('ask civi' -> DEFER); here Kivi has been misheard 4x and Sivi 0x, so Kivi is chosen.", "setup": [{"type": "explicit_correction", "chosen_form": "Kivi", "rejected_form": "kivee", "context": {"keywords": ["deploy", "service", "server", "restart"], "domain": "software"}}, {"type": "explicit_correction", "chosen_form": "Kivi", "rejected_form": "kiwie", "context": {"keywords": ["deploy", "service", "server", "restart"], "domain": "software"}}, {"type": "explicit_correction", "chosen_form": "Kivi", "rejected_form": "kivvy", "context": {"keywords": ["deploy", "service", "server", "restart"], "domain": "software"}}, {"type": "explicit_correction", "chosen_form": "Kivi", "rejected_form": "kewi", "context": {"keywords": ["deploy", "service", "server", "restart"], "domain": "software"}}], "input": "ask civi", "target_span": "civi", "expected_action": "REPLACE", "expected_output": "Ask Kivi.", "expect_reason_contains": "correction history"}
{"id": "personal-safety-01", "category": "personal_phonetics", "description": "an active accent profile must NOT override deliberate non-intervention: food context still KEEPs and the Kivi memory is untouched", "setup": [{"type": "explicit_correction", "chosen_form": "Kivi", "rejected_form": "kivee", "context": {"keywords": ["deploy", "service"], "domain": "software"}}, {"type": "explicit_correction", "chosen_form": "Kivi", "rejected_form": "kiwie", "context": {"keywords": ["deploy", "service"], "domain": "software"}}], "input": "the kiwi was ripe and sweet", "target_span": "kiwi", "expected_action": "KEEP", "expected_output": "The kiwi was ripe and sweet.", "check_stability": "Kivi"}
{"id": "personal-noop-01", "category": "personal_phonetics", "description": "an active accent profile does not manufacture candidates for unrelated words", "setup": [{"type": "explicit_correction", "chosen_form": "Rehan", "rejected_form": "lehaan", "context": {"keywords": ["tell", "sync"], "domain": "people"}}, {"type": "explicit_correction", "chosen_form": "Rehan", "rejected_form": "lehin", "context": {"keywords": ["tell", "sync"], "domain": "people"}}], "input": "deploy the zephyr module", "target_span": "zephyr", "expected_action": "KEEP", "expected_output": "Deploy the zephyr module."}
{"id": "semantic-01", "category": "semantic_context", "description": "food signal via a word absent from every keyword list ('edible') -> deliberate KEEP", "input": "Kivi is edible", "target_span": "kivi", "expected_action": "KEEP", "expected_output": "Kivi is edible.", "check_stability": "Kivi"}
{"id": "semantic-02", "category": "semantic_context", "description": "another un-listed food signal ('nutritious', 'fresh') generalised by the semantic-field layer -> KEEP", "input": "the kiwi was nutritious and fresh", "target_span": "kiwi", "expected_action": "KEEP", "expected_output": "The kiwi was nutritious and fresh.", "check_stability": "Kivi"}
{"id": "semantic-03", "category": "semantic_context", "description": "semantic layer must not suppress a genuine software context -> REPLACE still fires", "input": "roll back the kiwi deployment", "target_span": "kiwi", "expected_action": "REPLACE", "expected_output": "Roll back the Kivi deployment."}
{"id": "semantic-04", "category": "semantic_context", "description": "appearance words ('green', 'oval') in NO keyword list; the local embedding model places them near this memory's rejected (fruit) examples -> deliberate KEEP", "input": "Kivi is green and oval", "target_span": "kivi", "expected_action": "KEEP", "expected_output": "Kivi is green and oval.", "check_stability": "Kivi"}
{"id": "semantic-05", "category": "semantic_context", "description": "'crimson' never appears anywhere in the system; still resolved to fruit context by meaning -> KEEP", "input": "the kiwi looked crimson and juicy", "target_span": "kiwi", "expected_action": "KEEP", "expected_output": "The kiwi looked crimson and juicy.", "check_stability": "Kivi"}
{"id": "homophone-01", "category": "homophone", "description": "canonical 'sea' + alias 'see' are both common words; grammar puts 'see' in a verb slot -> KEEP, surface match + history cannot force it", "setup": [{"type": "explicit_correction", "chosen_form": "sea", "rejected_form": "see", "formatted_text": "The sea is huge.", "raw_asr_text": "the see is huge"}, {"type": "explicit_correction", "chosen_form": "sea", "rejected_form": "see", "formatted_text": "I sailed across the sea.", "raw_asr_text": "i sailed across the see"}], "input": "I see you", "target_span": "see", "expected_action": "KEEP", "expected_output": "I see you."}
{"id": "homophone-02", "category": "homophone", "description": "same memory; grammar puts 'see' in a noun slot (determiner before, 'is' after) -> REPLACE to 'sea', with no keyword context at all", "setup": [{"type": "explicit_correction", "chosen_form": "sea", "rejected_form": "see", "formatted_text": "The sea is huge.", "raw_asr_text": "the see is huge"}, {"type": "explicit_correction", "chosen_form": "sea", "rejected_form": "see", "formatted_text": "I sailed across the sea.", "raw_asr_text": "i sailed across the see"}], "input": "the see is calm today", "target_span": "see", "expected_action": "REPLACE", "expected_output": "The sea is calm today."}
{"id": "homophone-03", "category": "homophone", "description": "verb slot again ('you' before, determiner after); deliberate non-intervention even though 'see' was corrected to 'sea' twice", "setup": [{"type": "explicit_correction", "chosen_form": "sea", "rejected_form": "see", "formatted_text": "The sea is huge.", "raw_asr_text": "the see is huge"}, {"type": "explicit_correction", "chosen_form": "sea", "rejected_form": "see", "formatted_text": "I sailed across the sea.", "raw_asr_text": "i sailed across the see"}], "input": "can you see the screen", "target_span": "see", "expected_action": "KEEP", "expected_output": "Can you see the screen?"}
{"id": "homophone-04", "category": "homophone", "description": "short function word: 'no' must still reach retrieval (span builder skips <=2 chars unless the memory knows the form); verb slot -> REPLACE to 'know'", "setup": [{"type": "explicit_correction", "chosen_form": "know", "rejected_form": "no", "formatted_text": "I no you.", "raw_asr_text": "i no you"}], "input": "do you no where it is", "target_span": "no", "expected_action": "REPLACE", "expected_output": "Do you know where it is?"}
{"id": "homophone-05", "category": "homophone", "description": "same memory; 'no' in a determiner slot is a function word - one correction must never blanket-rewrite it -> KEEP", "setup": [{"type": "explicit_correction", "chosen_form": "know", "rejected_form": "no", "formatted_text": "I no you.", "raw_asr_text": "i no you"}], "input": "there is no problem", "target_span": "no", "expected_action": "KEEP", "expected_output": "There is no problem."}
{"id": "homophone-06", "category": "homophone", "description": "content-word homophone (son/sun): one correction applies where the MEANING agrees, but a family-context sentence is left alone - the taught override yields to a negative semantic lean", "setup": [{"type": "explicit_correction", "chosen_form": "Sun", "rejected_form": "son", "formatted_text": "The son glows.", "raw_asr_text": "the son glows"}], "input": "My son is studying law", "target_span": "son", "expected_action": "KEEP", "expected_output": "My son is studying law."}
{"id": "stability-01", "category": "memory_stability", "description": "a scoped rejection must never demote an established memory: after 3 rejections the authoritative floor still holds (active, 0.70) and a clearly-positive sentence still REPLACEs", "setup": [{"type": "explicit_correction", "chosen_form": "Sun", "rejected_form": "son", "formatted_text": "The son glows.", "raw_asr_text": "the son glows"}, {"type": "rejection", "rejected_form": "Sun", "chosen_form": "son", "formatted_text": "My son is studying law.", "raw_asr_text": "my son is studying law"}, {"type": "rejection", "rejected_form": "Sun", "chosen_form": "son", "formatted_text": "My son is a doctor.", "raw_asr_text": "my son is a doctor"}, {"type": "rejection", "rejected_form": "Sun", "chosen_form": "son", "formatted_text": "My son is at home.", "raw_asr_text": "my son is at home"}], "input": "son glows", "target_span": "son", "expected_action": "REPLACE", "expected_output": "Sun glows.", "check_stability": "Sun"}
