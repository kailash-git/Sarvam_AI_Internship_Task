/* ==========================================================================
   Kivi Workspace
   Dark warm console in a cream-outlined window, floating on a bokeh backdrop.
   Sidebar navigation · document-style content · floating voice capsule.
   ========================================================================== */

:root {
  /* surfaces — warm near-blacks */
  --ink-0: #141412;
  --ink-1: #1b1b18;   /* sidebar */
  --ink-2: #1e1e1b;   /* main pane */
  --ink-3: #262622;   /* hover */
  --ink-4: #2f2f2a;   /* active */

  /* the signature cream */
  --cream: #f7f2e6;
  --line:  rgba(247, 242, 230, .13);
  --hair:  rgba(247, 242, 230, .075);

  --txt-1: #ffffff;
  --txt-2: #b5b5ad;
  --txt-3: #85857c;
  --txt-4: #63635b;

  --orange: #f2a03d;
  --blue:   #8fb2ff;

  --ok:   #6fd08c;  --ok-bg:   rgba(111, 208, 140, .14);
  --warn: #e9b65c;  --warn-bg: rgba(233, 182, 92, .14);
  --bad:  #ef7b72;  --bad-bg:  rgba(239, 123, 114, .14);

  --gap-y: clamp(12px, 3.2vh, 42px);
  --gap-x: clamp(12px, 3vw, 54px);
  --rail:  300px;

  --font: 'DM Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  --mono: 'DM Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
}

* { box-sizing: border-box; }
html, body { margin: 0; height: 100%; }
html { background: #241c36; }
body {
  font-family: var(--font);
  font-size: 15px; line-height: 1.6;
  color: var(--txt-1);
  -webkit-font-smoothing: antialiased;
  overflow: hidden;
}
h1, h2, h3, p { margin: 0; }
button { font-family: inherit; cursor: pointer; }
a { color: var(--cream); }
code {
  font-family: var(--mono); font-size: .87em; color: var(--cream);
  background: rgba(247, 242, 230, .09); padding: .12em .42em; border-radius: 5px;
}
::selection { background: rgba(247, 242, 230, .24); }
:focus-visible { outline: 2px solid var(--cream); outline-offset: 2px; border-radius: 6px; }
@media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }

/* ---------- bokeh backdrop ---------- */
.bg {
  position: fixed; inset: 0; z-index: -1; pointer-events: none;
  background:
    radial-gradient(58% 54% at 10% 16%, #6d4ba3 0%, transparent 62%),
    radial-gradient(50% 48% at 90% 20%, #7e3f92 0%, transparent 60%),
    radial-gradient(46% 46% at 14% 90%, #d4762c 0%, transparent 58%),
    radial-gradient(52% 46% at 58% 98%, #1e8f85 0%, transparent 60%),
    radial-gradient(38% 40% at 94% 84%, #b8523f 0%, transparent 62%),
    #2a2140;
}

/* ---------- the app window ---------- */
.window {
  display: grid; grid-template-columns: var(--rail) 1fr;
  width: calc(100% - var(--gap-x) * 2);
  max-width: 1560px;
  height: calc(100dvh - var(--gap-y) * 2);
  margin: var(--gap-y) auto;
  background: var(--ink-2);
  border: 2px solid var(--cream);
  border-radius: 26px;
  overflow: hidden;
  box-shadow: 0 40px 120px -32px rgba(0, 0, 0, .72);
}

/* ==========================================================================
   Sidebar
   ========================================================================== */
.sidebar {
  display: flex; flex-direction: column;
  background: var(--ink-1);
  border-right: 2px solid var(--cream);
  padding: 22px 16px 18px;
  overflow-y: auto;
}
.sidebar::-webkit-scrollbar { width: 6px; }
.sidebar::-webkit-scrollbar-thumb { background: rgba(247, 242, 230, .1); border-radius: 3px; }

.brand { display: flex; align-items: center; gap: 12px; padding: 2px 8px 0; margin-bottom: 26px; }
.brand-tile {
  width: 38px; height: 38px; border-radius: 11px; flex: none;
  background: linear-gradient(158deg, #f9b95f, #ec8c2b);
  display: grid; place-items: center;
  box-shadow: 0 5px 16px rgba(236, 140, 43, .3);
}
.brand-tile svg { width: 21px; height: 21px; color: #2a1808; }
.brand-name { font-size: 16.5px; font-weight: 500; letter-spacing: -.2px; color: var(--txt-1); }

.nav { display: flex; flex-direction: column; gap: 2px; }
.navlink {
  display: flex; align-items: center; gap: 14px;
  width: 100%; height: 43px; padding: 0 12px;
  border: 0; background: none; border-radius: 10px;
  color: var(--txt-2); font-size: 15px; text-align: left;
  transition: background-color .16s ease, color .16s ease;
}
.navlink svg { width: 20px; height: 20px; flex: none; opacity: .92; }
.navlink:hover { background: var(--ink-3); color: var(--txt-1); }
.navlink.active { background: var(--ink-4); color: var(--txt-1); }

.nav-label {
  font-size: 12.5px; font-weight: 500; color: var(--txt-3);
  padding: 0 12px; margin: 26px 0 8px;
}

.side-stats { display: flex; flex-direction: column; gap: 1px; }
.side-stats .s {
  display: flex; align-items: center; gap: 12px;
  height: 35px; padding: 0 12px; border-radius: 9px;
  font-size: 14px; color: var(--txt-2);
}
.side-stats .s:hover { background: var(--ink-3); }
.side-stats .s .dot { width: 7px; height: 7px; border-radius: 2px; background: var(--txt-4); flex: none; }
.side-stats .s.hot .dot { background: var(--orange); }
.side-stats .s b {
  margin-left: auto; font-family: var(--mono); font-size: 12.5px; font-weight: 500;
  color: var(--txt-1); font-variant-numeric: tabular-nums;
}

.side-foot { margin-top: auto; padding-top: 20px; }
.nav-reset {
  display: flex; align-items: center; gap: 14px;
  width: 100%; height: 40px; padding: 0 12px;
  border: 0; background: none; border-radius: 10px;
  color: var(--txt-3); font-size: 14px; text-align: left;
  transition: background-color .16s ease, color .16s ease;
}
.nav-reset svg { width: 18px; height: 18px; flex: none; }
.nav-reset:hover { background: var(--bad-bg); color: var(--bad); }
.side-meta {
  font-family: var(--mono); font-size: 11px; letter-spacing: .2px;
  color: var(--txt-4); padding: 12px 12px 0;
}

/* ==========================================================================
   Content pane
   ========================================================================== */
.content { overflow-y: auto; overflow-x: hidden; }
.content::-webkit-scrollbar { width: 9px; }
.content::-webkit-scrollbar-thumb { background: rgba(247, 242, 230, .12); border-radius: 5px; }
.content::-webkit-scrollbar-thumb:hover { background: rgba(247, 242, 230, .2); }

.view { display: none; }
.view.on {
  display: flex; flex-direction: column; min-height: 100%;
  padding: 44px clamp(26px, 4vw, 62px) 0;
}

.page-head { display: flex; align-items: center; gap: 18px; }
.page-icon { width: 46px; height: 46px; border-radius: 14px; display: grid; place-items: center; flex: none; }
.page-icon svg { width: 24px; height: 24px; }
.i-chat { background: rgba(242, 160, 61, .16); color: var(--orange); }
.i-mem  { background: rgba(143, 178, 255, .15); color: var(--blue); }
.i-eval { background: rgba(111, 208, 140, .15); color: var(--ok); }
.page-head h1 {
  font-size: clamp(29px, 3.2vw, 44px); font-weight: 700;
  letter-spacing: -1.4px; line-height: 1.08; color: var(--txt-1);
}
.page-sub { margin: 17px 0 0; max-width: 76ch; font-size: 15px; line-height: 1.66; color: var(--txt-2); }

.sec {
  margin: 44px 0 4px; font-size: 21px; font-weight: 700; letter-spacing: -.3px;
  color: var(--txt-1); display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
}
.sec .count {
  font-family: var(--mono); font-size: 12px; font-weight: 400; color: var(--txt-3);
  background: var(--ink-3); border-radius: 6px; padding: 3px 8px;
}
.sec-sub { margin: 0 0 18px; font-size: 13.5px; color: var(--txt-3); }
.foot { margin: 14px 0 0; font-size: 12.5px; color: var(--txt-3); line-height: 1.6; }

/* ==========================================================================
   Chat / transcription
   ========================================================================== */
.stream { margin-top: 30px; min-height: 32vh; }
.empty { font-size: 15px; color: var(--txt-2); }
.chips { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 18px; }
.chip {
  background: transparent; border: 1px solid var(--line); color: var(--txt-2);
  font-size: 13.5px; padding: 9px 16px; border-radius: 999px;
  transition: border-color .16s ease, color .16s ease, background-color .16s ease;
}
.chip:hover { border-color: var(--cream); color: var(--txt-1); background: rgba(247, 242, 230, .06); }

.turn { margin-bottom: 30px; }
.user {
  display: inline-block; max-width: 82%; float: right; clear: both;
  background: var(--ink-3); border: 1px solid var(--hair);
  border-radius: 16px 16px 5px 16px; padding: 10px 15px;
  font-size: 14.5px; color: var(--txt-1);
}
.bot { clear: both; padding-top: 14px; }
.bot .meta {
  display: flex; align-items: center; gap: 11px; flex-wrap: wrap;
  font-size: 11.5px; color: var(--txt-3); margin-bottom: 9px;
}
.bot .meta .k { color: var(--orange); font-weight: 500; }
.bot .meta button {
  background: none; border: 1px solid var(--line); color: var(--txt-2);
  font-size: 11.5px; border-radius: 999px; padding: 3px 11px;
  transition: border-color .16s ease, color .16s ease;
}
.bot .meta button:hover { border-color: var(--cream); color: var(--txt-1); }
.bot .levels {
  margin: 8px 0 12px; font-family: var(--mono); font-size: 11.5px; color: var(--txt-3);
  background: var(--ink-1); border: 1px solid var(--hair); border-radius: 10px; padding: 10px 14px;
}
.bot .levels div { padding: 2px 0; }
.bot .levels .tag { color: var(--txt-2); }
.result { font-size: 19px; line-height: 1.72; letter-spacing: -.2px; color: var(--txt-1); }

.why { margin-top: 14px; border-top: 1px solid var(--hair); padding-top: 13px; display: none; }
.why.on { display: block; }
.why .row { font-size: 13px; color: var(--txt-2); padding: 6px 0; }
.why .row .b {
  display: inline-block; font-size: 9.5px; font-weight: 700; letter-spacing: .5px;
  padding: 2px 7px; border-radius: 5px; margin-right: 8px; vertical-align: 1px;
}
.b.REPLACE { background: rgba(242, 160, 61, .16); color: var(--orange); }
.b.DEFER   { background: var(--warn-bg); color: var(--warn); }
.b.KEEP    { background: rgba(247, 242, 230, .08); color: var(--txt-2); }
.why .accent { color: var(--blue); font-weight: 500; }

/* interactive words */
.w { border-radius: 3px; padding: 0 1px; cursor: text; transition: background-color .12s ease; }
.w:hover { background: rgba(247, 242, 230, .09); }
.w.rep { color: var(--orange); font-weight: 500; box-shadow: inset 0 -2px 0 var(--orange); }
.w.def { color: var(--warn); border-bottom: 1px dashed rgba(233, 182, 92, .6); }
.w.kc  { border-bottom: 1px dotted rgba(247, 242, 230, .3); }
.w.flash { background: var(--ok-bg); color: var(--ok); box-shadow: none; }
.wfix {
  font: inherit; color: var(--bad); background: var(--bad-bg); border: 0;
  border-bottom: 1px solid var(--bad); border-radius: 3px; padding: 0 2px;
  outline: none; min-width: 2ch;
}
.wmenu {
  position: absolute; z-index: 60; background: #2a2a25; border: 1px solid var(--line);
  border-radius: 12px; padding: 5px; display: flex; gap: 3px;
  box-shadow: 0 18px 40px -12px rgba(0, 0, 0, .8);
}
.wmenu button { background: none; border: 0; color: var(--txt-2); font-size: 12.5px; padding: 7px 11px; border-radius: 8px; }
.wmenu button:hover { background: rgba(247, 242, 230, .09); color: var(--txt-1); }
.wmenu button.accept { color: var(--orange); font-weight: 500; }

/* ---------- floating voice capsule ---------- */
.dock {
  position: sticky; bottom: 0; margin-top: auto;
  padding: 30px 0 32px;
  background: linear-gradient(to top, var(--ink-2) 64%, rgba(30, 30, 27, 0));
}
.toast { font-size: 12.5px; color: var(--warn); text-align: center; padding-bottom: 10px; }
.toast:empty { display: none; }
.composer {
  display: flex; align-items: center; gap: 10px;
  width: 100%; max-width: 680px; margin: 0 auto;
  background: var(--ink-1); border: 2px solid var(--cream);
  border-radius: 999px; padding: 7px 7px 7px 22px;
}
.composer textarea {
  flex: 1; resize: none; border: 0; outline: none; background: transparent;
  color: var(--txt-1); font: inherit; font-size: 15px; line-height: 1.5;
  max-height: 104px; padding: 9px 0;
}
.composer textarea::placeholder { color: #6f6f67; }

.mic {
  flex: none; width: 56px; height: 44px; border-radius: 999px;
  border: 1.6px solid var(--cream); background: transparent;
  display: grid; place-items: center;
  transition: background-color .16s ease, border-color .16s ease;
}
.mic:hover { background: rgba(247, 242, 230, .1); }
.mic.rec { background: var(--bad); border-color: var(--bad); }
.wave { display: flex; align-items: center; gap: 2px; height: 22px; }
.wave i { display: block; width: 2px; border-radius: 1px; background: var(--cream); }
.wave i:nth-child(1)  { height: 5px; }
.wave i:nth-child(2)  { height: 11px; }
.wave i:nth-child(3)  { height: 7px; }
.wave i:nth-child(4)  { height: 17px; }
.wave i:nth-child(5)  { height: 9px; }
.wave i:nth-child(6)  { height: 21px; }
.wave i:nth-child(7)  { height: 13px; }
.wave i:nth-child(8)  { height: 22px; }
.wave i:nth-child(9)  { height: 8px; }
.wave i:nth-child(10) { height: 16px; }
.wave i:nth-child(11) { height: 6px; }
.wave i:nth-child(12) { height: 11px; }
.wave i:nth-child(13) { height: 5px; }
.mic.rec .wave i { background: #fff; animation: bar .82s ease-in-out infinite; }
.mic.rec .wave i:nth-child(2n) { animation-delay: .11s; }
.mic.rec .wave i:nth-child(3n) { animation-delay: .22s; }
.mic.rec .wave i:nth-child(5n) { animation-delay: .33s; }
@keyframes bar { 0%, 100% { transform: scaleY(.4); } 50% { transform: scaleY(1.55); } }

.send {
  flex: none; width: 44px; height: 44px; border-radius: 999px; border: 0;
  background: var(--cream); color: #1a1a17; display: grid; place-items: center;
  transition: transform .14s ease, opacity .14s ease;
}
.send svg { width: 19px; height: 19px; }
.send:hover { transform: translateY(-1px); }
.send:disabled { opacity: .42; transform: none; cursor: default; }

audio { height: 34px; width: 100%; max-width: 680px; margin: 14px auto 0; display: block; filter: invert(.9) hue-rotate(180deg); }
[hidden] { display: none !important; }

/* ==========================================================================
   Memory
   ========================================================================== */
.statebar { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 26px; }
.statebar .cell {
  display: flex; flex-direction: column-reverse; gap: 3px;
  min-width: 108px; padding: 12px 15px;
  background: var(--ink-1); border: 1px solid var(--line); border-radius: 13px;
}
.statebar .cell span { font-size: 11px; color: var(--txt-3); }
.statebar .cell b {
  font-family: var(--mono); font-size: 19px; font-weight: 500; letter-spacing: -.5px;
  color: var(--txt-1); font-variant-numeric: tabular-nums;
}
.statebar .cell.hot { border-color: rgba(242, 160, 61, .4); }
.statebar .cell.hot b { color: var(--orange); }

/* tables */
.tbl-wrap { overflow-x: auto; }
.tbl { width: 100%; border-collapse: collapse; font-size: 13.5px; }
.tbl th {
  text-align: left; font-size: 10.5px; font-weight: 500; letter-spacing: .7px;
  text-transform: uppercase; color: var(--txt-3);
  padding: 0 18px 10px 0; border-bottom: 1px solid var(--line); white-space: nowrap;
}
.tbl td { padding: 12px 18px 12px 0; border-bottom: 1px solid var(--hair); color: var(--txt-2); vertical-align: top; }
.tbl td.m, .tbl th.m { font-family: var(--mono); font-variant-numeric: tabular-nums; }
.tbl tr:last-child td { border-bottom: 0; }
.tbl .pos-w { color: var(--ok); }
.tbl .neg-w { color: var(--bad); }
table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
th { text-align: left; color: var(--txt-3); font-weight: 500; padding: 8px 10px; border-bottom: 1px solid var(--line); }
td { padding: 10px; border-bottom: 1px solid var(--hair); color: var(--txt-2); }
tr.click { cursor: pointer; }
tr.click:hover td { color: var(--txt-1); }
.mono { font-family: var(--mono); font-size: 11.5px; font-variant-numeric: tabular-nums; }

.meter { position: relative; height: 6px; border-radius: 3px; background: rgba(247, 242, 230, .12); overflow: hidden; }
.meter > i { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 3px; background: var(--orange); transition: width .35s ease; }

.tag { font-size: 10.5px; padding: 2px 8px; border-radius: 5px; font-weight: 500; }
.tag.active { background: var(--ok-bg); color: var(--ok); }
.tag.proposed { background: var(--warn-bg); color: var(--warn); }
.tag.contested, .tag.inactive { background: rgba(247, 242, 230, .07); color: var(--txt-3); }
.pill-s { display: inline-block; font-size: 11px; font-weight: 500; text-transform: capitalize; padding: 3px 10px; border-radius: 6px; }
.pill-s.active { background: var(--ok-bg); color: var(--ok); }
.pill-s.proposed { background: var(--warn-bg); color: var(--warn); }
.pill-s.contested { background: var(--bad-bg); color: var(--bad); }
.pill-s.inactive { background: rgba(247, 242, 230, .07); color: var(--txt-3); }
.alias {
  display: inline-block; background: rgba(247, 242, 230, .06); border: 1px solid var(--hair);
  border-radius: 6px; padding: 2px 8px; margin: 2px 3px 0 0; font-size: 11.5px; color: var(--txt-2);
}

/* memory entries list */
.mem-list { display: flex; flex-direction: column; }
.mem-card { border-top: 1px solid var(--hair); }
.mem-card:first-child { border-top: 0; }
.mem-row {
  display: grid;
  grid-template-columns: minmax(160px, 1fr) 96px clamp(140px, 15vw, 230px) minmax(262px, 1.1fr) 16px;
  align-items: center; gap: 20px; padding: 17px 10px; cursor: pointer; border-radius: 12px;
  transition: background-color .14s ease;
}
.mem-row:hover, .mem-card.open .mem-row { background: var(--ink-3); }
.mem-name { font-size: 15.5px; font-weight: 500; color: var(--txt-1); letter-spacing: -.2px; }
.mem-name small { display: block; font-size: 12px; font-weight: 400; color: var(--txt-3); margin-top: 3px; }
.mem-conf { display: flex; flex-direction: column; gap: 7px; }
.mem-conf .v { font-family: var(--mono); font-size: 11px; color: var(--txt-3); }
.mem-tally { font-family: var(--mono); font-size: 11px; color: var(--txt-3); line-height: 1.55; }
.mem-tally b { color: var(--txt-2); font-weight: 500; }
.chev { justify-self: end; color: var(--txt-3); font-size: 11px; transition: transform .16s ease; }
.mem-card.open .chev { transform: rotate(90deg); color: var(--orange); }

.mem-body { padding: 6px 10px 28px; display: grid; gap: 30px; animation: memslide .18s ease; }
@keyframes memslide { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
.blk-title {
  font-size: 11px; font-weight: 500; letter-spacing: .8px; text-transform: uppercase;
  color: var(--txt-3); margin-bottom: 13px;
}
.blk-title .q { letter-spacing: 0; text-transform: none; font-size: 11.5px; color: var(--txt-4); margin-left: 10px; }
.ctx-line { font-size: 13.5px; color: var(--txt-2); margin: 7px 0; display: flex; flex-wrap: wrap; gap: 9px; align-items: baseline; }
.ctx-line .k { color: var(--txt-3); font-family: var(--mono); font-size: 11px; }
.chipset { display: inline-flex; flex-wrap: wrap; gap: 6px; }
.chip2 {
  font-family: var(--mono); font-size: 11.5px; color: var(--txt-2);
  background: rgba(247, 242, 230, .06); border: 1px solid var(--hair);
  border-radius: 6px; padding: 3px 9px;
}
.dec-sum { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px; }
.dec-sum .d { font-family: var(--mono); font-size: 11.5px; padding: 4px 10px; border-radius: 6px; background: rgba(247, 242, 230, .06); color: var(--txt-2); }
.dec-sum .d.rep  { color: var(--orange); background: rgba(242, 160, 61, .14); }
.dec-sum .d.def  { color: var(--warn); background: var(--warn-bg); }
.dec-sum .d.keep { color: var(--txt-3); }
.mem-actions { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
.btn-danger {
  background: transparent; border: 1px solid rgba(239, 123, 114, .4); color: var(--bad);
  font-size: 12.5px; font-weight: 500; padding: 8px 15px; border-radius: 9px;
  transition: background-color .16s ease;
}
.btn-danger:hover { background: var(--bad-bg); }
.empty-note { font-size: 12.5px; color: var(--txt-3); font-style: italic; }

/* observation forms */
.obs-forms { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; max-width: 880px; }
.obs-card {
  background: var(--ink-1); border: 1px solid var(--line); border-radius: 16px;
  padding: 20px; display: flex; flex-direction: column; gap: 12px;
}
.obs-card .obs-t { font-size: 14px; font-weight: 500; color: var(--txt-1); }
.obs-card label { display: flex; flex-direction: column; gap: 6px; font-size: 12.5px; color: var(--txt-3); }
.obs-card input, .teach input {
  font: inherit; font-size: 14px; color: var(--txt-1);
  background: rgba(247, 242, 230, .05); border: 1px solid var(--line);
  border-radius: 10px; padding: 10px 13px; outline: none;
  transition: border-color .16s ease;
}
.obs-card input:focus, .teach input:focus { border-color: var(--cream); }
.obs-card input::placeholder { color: var(--txt-4); }
.obs-card button {
  align-self: flex-start; margin-top: 4px;
  background: var(--cream); color: #1a1a17; border: 0;
  font-size: 13.5px; font-weight: 500; padding: 10px 22px; border-radius: 999px;
  transition: transform .14s ease;
}
.obs-card button:hover { transform: translateY(-1px); }
.teach { display: flex; flex-wrap: wrap; gap: 8px; }

/* ==========================================================================
   Evaluation
   ========================================================================== */
.ghost {
  align-self: flex-start;
  background: transparent; border: 1.5px solid var(--cream); color: var(--cream);
  font-size: 13.5px; font-weight: 500; padding: 10px 20px; border-radius: 999px;
  transition: background-color .16s ease;
}
.ghost:hover { background: rgba(247, 242, 230, .1); }
.sub { font-size: 13.5px; color: var(--txt-2); }
.statgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(148px, 1fr)); gap: 10px; margin-top: 22px; }
.stat { background: var(--ink-1); border: 1px solid var(--line); border-radius: 14px; padding: 17px 18px; }
.stat .n {
  font-family: var(--mono); font-size: 22px; font-weight: 500; letter-spacing: -.6px;
  color: var(--txt-1); font-variant-numeric: tabular-nums;
}
.stat .l { font-size: 11px; color: var(--txt-3); margin-top: 5px; }
.report {
  white-space: pre-wrap; font-family: var(--mono); font-size: 11.5px; line-height: 1.65;
  color: var(--txt-2); background: var(--ink-0); border: 1px solid var(--hair);
  border-radius: 14px; padding: 20px; max-height: 480px; overflow: auto; margin: 20px 0 0;
}

/* bottom breathing room for the scrolling panes */
#view-memory.on, #view-eval.on { padding-bottom: 60px; }

/* ==========================================================================
   Responsive
   ========================================================================== */
@media (max-width: 1080px) {
  :root { --rail: 250px; }
  .mem-row { grid-template-columns: minmax(150px, 1fr) 100px 1fr 16px; }
  .mem-row .mem-tally { display: none; }
}
@media (max-width: 820px) {
  body { overflow: auto; }
  .window {
    grid-template-columns: 1fr; height: auto; min-height: calc(100dvh - var(--gap-y) * 2);
    border-radius: 22px;
  }
  .sidebar {
    border-right: 0; border-bottom: 2px solid var(--cream);
    padding: 16px 12px;
  }
  .nav { flex-direction: row; overflow-x: auto; gap: 4px; }
  .navlink { width: auto; white-space: nowrap; padding: 0 14px; }
  .nav-label, .side-stats, .side-meta { display: none; }
  .side-foot { margin-top: 12px; padding-top: 0; }
  .nav-reset { width: auto; }
  .view.on { padding: 28px 20px 0; }
  .page-head { gap: 13px; }
  .page-icon { width: 38px; height: 38px; border-radius: 12px; }
  .page-icon svg { width: 20px; height: 20px; }
  .mem-row { grid-template-columns: 1fr auto 16px; gap: 14px; }
  .mem-row .mem-conf { display: none; }
  .composer { padding-left: 16px; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important; }
}
